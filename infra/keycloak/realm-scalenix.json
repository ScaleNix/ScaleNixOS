      "firstName": "Malik",
      "lastName": "Benmekki",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["user", "developer", "admin", "default-roles-scalenix-os"],
      "credentials": [
        {
          "type": "password",
          "value": "changeme",
          "temporary": false
        }
      ]
    },
    {
